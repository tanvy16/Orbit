# Orbit environment configuration (copy to .env for local overrides)

# FastAPI backend
ORBIT_API_HOST=127.0.0.1
ORBIT_API_PORT=18765
ORBIT_API_BASE_URL=http://127.0.0.1:18765
ORBIT_CHROMA_PATH=./backend/data/chroma

# SQLite database (relative to backend/)
ORBIT_DATABASE_URL=sqlite:///./data/orbit.db

# Logging
ORBIT_LOG_LEVEL=info

# Electron / frontend (injected at build via Vite)
VITE_API_BASE_URL=http://127.0.0.1:18765
